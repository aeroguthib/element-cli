{
    "compilerOptions": {
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true,
        "target": "ES2022",
        "sourceMap": false,
        "outDir": "./lib",
        "rootDir": "./src",
        "declaration": true,
        "lib": ["ES2022"],
        "strict": true,
        "types": ["node"],
        "typeRoots": ["../../node_modules/@types"]
    },
    "include": ["./src/**/*.ts"],
    "exclude": ["./test/**/*.ts", "./lib/**/*"]
}
